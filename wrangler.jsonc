{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mercados",
  // Cuenta propia de Mercados (separada de la de la Bitácora). El id no es secreto.
  "account_id": "44ad19052da3858dae65640ed99fcae6",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // El Worker se ejecuta antes que los assets en TODAS las rutas: así valida
  // Cloudflare Access incluso para el HTML y añade cabeceras de seguridad.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  // Sin URLs de preview: cada versión subida tendría su propia URL pública.
  "workers_dev": true,
  "preview_urls": false,

  "kv_namespaces": [
    {
      // Caché de precios, historial, BCRP y FRED. Ojo: el plan gratis permite
      // 1.000 escrituras/día (la Cache API no funciona detrás de Access).
      "binding": "CACHE",
      "id": "8e4e026c93df477eb3692019bd50fd3b"
    }
  ],

  // Variables NO secretas. Claves y configuración de Access van como secretos
  // (panel de Cloudflare → Variables and Secrets), nunca en el repo.
  "vars": {
    "TIMEZONE": "America/Lima",
    // Worker del conector de Claude: destino fijo del paso /conector/identidad.
    "MCP_URL": "https://mercados-mcp.mercados.workers.dev",
    // La misma cuenta de arriba: «Personas» la usa para escribir en Access y enlazar su panel.
    "CF_ACCOUNT_ID": "44ad19052da3858dae65640ed99fcae6"
  },

  // Lista diaria: la tarea revisa cada 10 minutos qué cierres faltan y pide unos pocos por vez (1 crédito por símbolo
  // al día, después del cierre de Nueva York). Casi siempre no hace nada: solo lee dos registros de KV.
  "triggers": { "crons": ["*/10 * * * *"] },

  "observability": { "enabled": true }
}
