# Copia este archivo a `.env` para desarrollo local (`npm run dev`).
# `.env` está en .gitignore. En producción, estos valores se cargan en el panel de
# Cloudflare (Workers → mercados → Settings → Variables and Secrets, tipo Secret).

# --- Claves de datos (opcionales en local si usas MOCK_DATA=true)
TWELVE_DATA_API_KEY=
FRED_API_KEY=

# --- Cloudflare Access (solo producción; en local se ignora con DEV_MODE=true)
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# Lista vieja de quién entra, separados por comas: ahora se maneja en Rueda («Personas»), que la usa
# solo hasta el primer cambio.
ALLOWED_EMAILS=
# Solo el dueño: ve los precios de Twelve Data. Los demás ven solo datos públicos.
OWNER_EMAILS=
# Token de Cloudflare con un solo permiso («Access: Apps and Policies → Edit»): «Personas» copia la lista a Access.
ACCESS_API_TOKEN=

# --- Solo desarrollo local. Se ignoran salvo que la petición llegue a localhost/127.0.0.1.
DEV_MODE=true
# Datos ficticios en lugar de llamar a Twelve Data / BCRP / FRED.
MOCK_DATA=true
# En local se entra como dueño; DEV_ROLE=friend muestra la vista de amigos (o usa la config mercados-amigo-dev).
DEV_ROLE=
